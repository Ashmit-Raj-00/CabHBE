# Registrations are saved to a Google Sheet — see README.md → "Registrations".
# The Apps Script Web app URL (ends in /exec). If left empty, `npm run dev` just
# logs registrations to the terminal; in production the form shows an error.
GOOGLE_SHEET_WEBHOOK_URL="https://script.google.com/macros/s/XXXXXXXX/exec"

# Must match SECRET in google-sheet/registrations.gs — generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
GOOGLE_SHEET_SECRET="replace-with-a-long-random-string"

# Public site URL — used to build the Open Graph share image and canonical links
NEXT_PUBLIC_SITE_URL="https://your-domain.example"
